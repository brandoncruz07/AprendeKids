{
  "projectType": "webapp",
  "setup": [
    {
      "command": "npm",
      "args": ["ci", "--prefer-offline", "--no-audit", "--fund=false"],
      "timeoutSeconds": 600
    }
  ],
  "assertions": [
    {
      "name": "typecheck",
      "kind": "process",
      "command": "npm",
      "args": ["run", "typecheck"],
      "verificationMethod": "exit-code",
      "expected": "0",
      "timeoutSeconds": 180
    },
    {
      "name": "tests-pass",
      "kind": "process",
      "command": "npm",
      "args": ["test"],
      "verificationMethod": "test-results",
      "expected": "0",
      "timeoutSeconds": 300
    },
    {
      "name": "production-build",
      "kind": "process",
      "command": "npm",
      "args": ["run", "build"],
      "verificationMethod": "exit-code",
      "expected": "0",
      "timeoutSeconds": 300
    },
    {
      "name": "home-page-200",
      "kind": "http-probe",
      "startCommand": "npm",
      "startArgs": ["run", "dev", "--", "--host", "127.0.0.1", "--port", "5173", "--strictPort"],
      "url": "http://127.0.0.1:5173/",
      "verificationMethod": "http-status",
      "expected": "200",
      "timeoutSeconds": 120
    }
  ]
}
